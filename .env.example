# Copy to .env and fill in local values. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=false
LOG_LEVEL=info

# MongoDB connection string. GridFS image bytes live in this same database.
MONGODB_URI=mongodb://127.0.0.1:27017/aprotel_solar

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Session cookies. COOKIE_SECURE defaults to true in production.
# On Render, set COOKIE_SAMESITE=none and COOKIE_SECURE=true so the Vercel admin can sign in.
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=120
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# One-time super administrator. Used only when no super administrator exists.
# Leave blank in shared environments. Never commit a real password.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

PASSWORD_RESET_TTL_MINUTES=30

# Optional SMTP for password reset emails. Without SMTP, development logs the reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbox for catalogue requests. The request is still saved when this is blank.
ORDER_NOTIFY_EMAIL=

MEDIA_MAX_BYTES=8388608
MEDIA_MAX_DIMENSION=8000
MEDIA_ORPHAN_TTL_HOURS=24

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX=30

# development | none | paystack | flutterwave
# development is refused when NODE_ENV=production. Use none when the site does not take payment.
PAYMENT_PROVIDER=development
DEV_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# PUBLIC_APP_URL is the admin site. API_PUBLIC_URL is this API's public address.
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

RESERVATION_TTL_MINUTES=30
RUN_JOBS=true
